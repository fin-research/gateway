{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eastmoney-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "eastmoney.hasbai.xyz/*",
      "zone_name": "hasbai.xyz"
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://eastmoney.hasbai.xyz",
    "AUTH0_DOMAIN": "hasbai.eu.auth0.com",
    "AUTH0_LOGIN_DOMAIN": "auth.hasbai.xyz",
    "AUTH0_CLIENT_ID": "16vMxoYpr5AdPRiW1PkwIiHuRWszii6m",
    "AUTH0_MCP_CLIENT_ID": "M1a5PF3UJaFIZv1k4HO4IV06Z5fXQBHV",
    "AUTH0_AUDIENCE": "https://eastmoney.hasbai.xyz/",
    "AUTH0_MANAGEMENT_CLIENT_ID": "LA46CcB3FQ4Uac4JyEzPSObcV4PV8CFU",
    "AUTHORIZATION_MODE": "beta-open",
    "AUTH0_MACHINE_CLIENT_IDS": "9t8TBoWunhy0MXjI8rvXm6wgVb45nwnS"
  },
  "secrets": {
    "required": [
      "AUTH0_CLIENT_SECRET",
      "AUTH0_MANAGEMENT_CLIENT_SECRET",
      "SESSION_SECRET"
    ]
  },
  "services": [
    {
      "binding": "DASHBOARD",
      "service": "eastmoney-dashboard",
      "entrypoint": "GatewayDashboard"
    },
    {
      "binding": "DATA",
      "service": "eastmoney-data",
      "entrypoint": "GatewayData"
    }
  ],
  "hyperdrive": [
    {
      "binding": "AUTHORIZATION_DB",
      "id": "4029d2cc81ff452bbc2c907162273162"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
